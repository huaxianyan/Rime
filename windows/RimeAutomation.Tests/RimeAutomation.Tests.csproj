<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>RimeAutomation.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 同一份生产源码，测试宿主只替换外部安装信息和小狼毫进程。 -->
